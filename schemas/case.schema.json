{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original synthetic development scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "description",
    "organization_id",
    "current_payment_id",
    "scoring_at",
    "training_cutoff",
    "observations",
    "labels",
    "purpose"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "current_payment_id": {
      "type": "string"
    },
    "scoring_at": {
      "type": "string",
      "format": "date-time"
    },
    "training_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payment_id",
          "organization_id",
          "sender_id",
          "recipient_id",
          "occurred_at",
          "available_at",
          "amount_minor",
          "currency",
          "channel",
          "device_id"
        ],
        "properties": {
          "payment_id": {
            "type": "string",
            "pattern": "^syn-pay-"
          },
          "organization_id": {
            "type": "string",
            "pattern": "^syn-org-"
          },
          "sender_id": {
            "type": "string",
            "pattern": "^syn-account-"
          },
          "recipient_id": {
            "type": "string",
            "pattern": "^syn-account-"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "available_at": {
            "type": "string",
            "format": "date-time"
          },
          "amount_minor": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "enum": [
              "GBP",
              "INR",
              "USD"
            ]
          },
          "channel": {
            "enum": [
              "account_transfer"
            ]
          },
          "device_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payment_id",
          "organization_id",
          "status",
          "class",
          "available_at",
          "provenance"
        ],
        "properties": {
          "payment_id": {
            "type": "string"
          },
          "organization_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "resolved",
              "unresolved"
            ]
          },
          "class": {
            "enum": [
              "legitimate",
              "fraudulent",
              null
            ]
          },
          "available_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "provenance": {
            "const": "original_synthetic_oracle"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unresolved"
                }
              }
            },
            "then": {
              "properties": {
                "class": {
                  "type": "null"
                },
                "available_at": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "class": {
                  "enum": [
                    "legitimate",
                    "fraudulent"
                  ]
                },
                "available_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        ]
      }
    },
    "purpose": {
      "const": "development_specification_not_benchmark"
    }
  }
}
