{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expected behavior specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "expected_status",
    "eligible_history_ids",
    "eligible_training_label_ids",
    "required_behaviors",
    "forbidden_behaviors",
    "requirement_ids",
    "measured_model_result"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string"
    },
    "expected_status": {
      "enum": [
        "valid_input",
        "input_error"
      ]
    },
    "eligible_history_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "eligible_training_label_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "required_behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "forbidden_behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^FR[0-9]{2}$"
      }
    },
    "measured_model_result": {
      "type": "null"
    }
  }
}
